# Copia este archivo como .env.local y pon tu clave real.
# .env.local NO se sube a git (está en .gitignore) y la clave nunca llega al navegador.

# Clave de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Solo si tu clave NO tiene espacio de trabajo ("Alcance" vacío al crearla):
# ID del espacio de trabajo (Console → Configuración → Espacios de trabajo).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Opcional: modelo a usar (por defecto claude-opus-5).
# Más barato y nuevo: claude-opus-5-5 · Aún más barato: claude-sonnet-5
# ANTHROPIC_MODEL=claude-opus-5-5
