# Copia este archivo como .env.local y pon tu clave real.
# .env.local NO se sube a git (está en .gitignore) y la clave nunca llega al navegador.

# Clave de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar (por defecto claude-opus-5).
# Para gastar menos: claude-sonnet-5
# ANTHROPIC_MODEL=claude-opus-5
